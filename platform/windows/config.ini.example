# 泰深输入法配置
# 放在 DLL 同目录（platform/windows/out/config.ini）

# 候选词数量上限（1-20，默认 5——固定 5 组词汇，Eric 设计要求）
candidate_count=5

# 候选排序模式（0=默认 词频+长词过滤，1=单字优先，2=长词优先）
sort_mode=0

# 上下文联想（上屏"北京"后输入 da 优先"大学"，1=开 0=关）
context_assoc=0

# 专业词库（v2 自动加载）：resources/domains/*.txt 启动时自动扫描，
# 热词探测自动匹配领域，无需手动配置。本键保留兼容（不再生效）。

# 系统词库路径（相对 DLL 目录，或绝对路径；留空 = 内置词库）
# dict_path=system_dict.db

# 用户词库路径（V0.2.2：选词自动学习，越用越懂你）
# 留空 = 默认 %APPDATA%/taishen-ime/user_dict.db
# user_dict_path=

# 模糊音开关（RIME 拼写变体：平翘舌/前后鼻音/n-l/f-h，0.1.14）
fuzzy=1

# 智能纠错开关（键盘相邻键容错：logn→long，快速打字误触纠正，0.2.10）
# correction=1

# 中英混输开关（中文模式候选末尾追加英文候选，0.2.8）
# mix_mode=1

# 简繁转换开关（候选输出转繁体，港台用户/书面写作，0.2.11）
# traditional=0

# 快捷短语开关（简码 → 常用文本，0.2.12）
# phrase=1

# 自定义短语文件（每行 code=text，# 开头为注释，UTF-8 编码）
# phrase_path=phrases.txt

# 候选窗口主题（V0.2.4）：四色自定义（HEX RRGGBB，如 F5F5F5）
# theme_bg=F5F5F5
# theme_text=333333
# theme_highlight=0078D4
# theme_dim=999999

# 双拼模式（RIME 微软双拼方案，0.1.14）
# shuangpin=0

# 双拼方案（mspy/flypy/sogou/zrm/ziguang/jiajia）
# shuangpin_scheme=mspy

# 行内预编辑（拼音写组合，候选窗不重复）
# inline_preedit=1

# 英文标点透传（1=英文标点，0=中文全角）
# ascii_punct=0

# 配对符号成对上屏（1=成对+光标居中，0=单符号）
pair_punct=1

# 诊断日志（1=开，0=关——默认关，开发调试用）
debug_log=0

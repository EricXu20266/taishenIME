// 泰深输入法 DLL 资源
// 资源 ID 1 = 语言栏 / 输入指示器图标（多尺寸 16~256）
// 注意：这里直接写字面量 1 而不是宏——rc.exe 在 configure 生成的独立目录中
// 对该头文件的宏展开不可靠（曾把 IDI_APP_ICON 当成字符串资源名）。
// 与 include/resource.h 的 IDI_APP_ICON=1 及注册表 IconIndex=0 保持一致。
// 图标路径由 CMake configure_file 注入绝对路径。
1 ICON "@TAISHEN_ICON_FILE@"
2 ICON "@TAISHEN_ZH_ICON@"
3 ICON "@TAISHEN_EN_ICON@"

// 版本资源：签名服务（SignPath 等）要求 ProductName / ProductVersion 存在且稳定
1 VERSIONINFO
FILEVERSION @TAISHEN_VERSION_COMMA@
PRODUCTVERSION @TAISHEN_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE @TAISHEN_FILETYPE@
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Taishen IME"
            VALUE "FileDescription", "@TAISHEN_FILE_DESC@"
            VALUE "FileVersion", "@TAISHEN_VERSION_DOTTED@"
            VALUE "InternalName", "@TAISHEN_INTERNAL_NAME@"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "@TAISHEN_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Taishen IME"
            VALUE "ProductVersion", "@TAISHEN_VERSION_DOTTED@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

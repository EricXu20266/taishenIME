// 设置对话框资源模板
// 对应 SPEC: docs/modules/settings-ui/SPEC.md
// 编码：UTF-8 with BOM（MSVC rc.exe 可正确编译中文字符串）

#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// ── 主设置对话框 ──
IDD_SETTINGS DIALOGEX 0, 0, 430, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "泰深输入法设置"
FONT 9, "Microsoft YaHei", 400, 0, 0x86
BEGIN
    CONTROL "", IDC_TAB_MAIN, "SysTabControl32", WS_TABSTOP, 10, 10, 410, 280

    // ── 页 0 基础 ──
    LTEXT "候选词数量 (1-20)", -1, 22, 32, 90, 10
    EDITTEXT IDC_EDIT_CANDIDATE, 120, 30, 44, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "候选窗字体", -1, 22, 54, 90, 10
    EDITTEXT IDC_EDIT_FONT_FACE, 120, 52, 220, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "正文字号 (12-32)", -1, 22, 76, 90, 10
    EDITTEXT IDC_EDIT_FONT_SIZE, 120, 74, 44, 12, ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX "行内预编辑（拼音写组合，候选窗不重复）", IDC_CHK_INLINE_PREEDIT, 22, 98, 260, 12
    LTEXT "候选标签格式（如 %d. 或 ①）", -1, 22, 120, 160, 10
    EDITTEXT IDC_EDIT_LABEL_FORMAT, 190, 118, 150, 12, ES_AUTOHSCROLL | WS_TABSTOP

    // ── 页 1 输入 ──
    AUTOCHECKBOX "模糊音（平翘舌/前后鼻音）", IDC_CHK_FUZZY, 22, 32, 170, 12
    AUTOCHECKBOX "中英混输", IDC_CHK_MIX_MODE, 215, 32, 110, 12
    AUTOCHECKBOX "智能纠错（相邻键容错）", IDC_CHK_CORRECTION, 22, 54, 170, 12
    AUTOCHECKBOX "简繁转换", IDC_CHK_TRADITIONAL, 215, 54, 110, 12
    AUTOCHECKBOX "双拼模式", IDC_CHK_SHUANGPIN, 22, 76, 110, 12
    AUTOCHECKBOX "Emoji 候选", IDC_CHK_EMOJI, 215, 76, 110, 12
    LTEXT "双拼方案", -1, 22, 100, 60, 10
    COMBOBOX IDC_COMBO_SCHEME, 90, 98, 150, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "快捷短语（简码→短语）", IDC_CHK_PHRASE, 22, 124, 170, 12
    AUTOCHECKBOX "英文标点透传", IDC_CHK_ASCII_PUNCT, 215, 124, 110, 12

    // ── 页 2 外观 ──
    LTEXT "主题模式", -1, 22, 32, 60, 10
    COMBOBOX IDC_COMBO_THEME, 90, 30, 110, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "自定义配色...", IDC_BTN_THEME_COLORS, 215, 28, 90, 15
    LTEXT "窗口圆角 (1-16)", -1, 22, 56, 90, 10
    EDITTEXT IDC_EDIT_CORNER, 120, 54, 44, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "高亮圆角 (1-16)", -1, 22, 78, 90, 10
    EDITTEXT IDC_EDIT_HILITE_CORNER, 120, 76, 44, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "内边距 (0-20)", -1, 22, 100, 90, 10
    EDITTEXT IDC_EDIT_PADDING, 120, 98, 44, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "候选间距 (0-40)", -1, 22, 122, 90, 10
    EDITTEXT IDC_EDIT_SPACING, 120, 120, 44, 12, ES_NUMBER | WS_TABSTOP

    // ── 页 3 高级 ──
    LTEXT "应用级英文模式（逗号分隔进程名，如 cod.exe）", -1, 22, 32, 230, 10
    EDITTEXT IDC_EDIT_APP_ASCII, 240, 30, 170, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "系统词库路径（空=内置）", -1, 22, 56, 150, 10
    EDITTEXT IDC_EDIT_DICT_PATH, 180, 54, 230, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "用户词库路径（空=默认）", -1, 22, 80, 150, 10
    EDITTEXT IDC_EDIT_USER_DICT_PATH, 180, 78, 230, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "自定义短语路径（空=仅内置）", -1, 22, 104, 160, 10
    EDITTEXT IDC_EDIT_PHRASE_PATH, 190, 102, 220, 12, ES_AUTOHSCROLL | WS_TABSTOP

    // ── 底部按钮 ──
    PUSHBUTTON "打开配置文件", IDC_BTN_OPEN_CONFIG, 20, 300, 88, 14
    PUSHBUTTON "恢复默认", IDC_BTN_DEFAULTS, 118, 300, 70, 14
    DEFPUSHBUTTON "确定", IDOK, 280, 300, 60, 14
    PUSHBUTTON "取消", IDCANCEL, 350, 300, 60, 14
END

// ── 配色子对话框 ──
IDD_THEME_COLORS DIALOGEX 0, 0, 330, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自定义配色"
FONT 9, "Microsoft YaHei", 400, 0, 0x86
BEGIN
    LTEXT "背景", -1, 12, 16, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 0, 90, 14, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 0, 155, 16, 90, 10

    LTEXT "正文", -1, 12, 38, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 1, 90, 36, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 1, 155, 38, 90, 10

    LTEXT "序号", -1, 12, 60, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 2, 90, 58, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 2, 155, 60, 90, 10

    LTEXT "注释", -1, 12, 82, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 3, 90, 80, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 3, 155, 82, 90, 10

    LTEXT "边框", -1, 12, 104, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 4, 90, 102, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 4, 155, 104, 90, 10

    LTEXT "选中背景", -1, 12, 126, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 5, 90, 124, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 5, 155, 126, 90, 10

    LTEXT "选中文字", -1, 12, 148, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 6, 90, 146, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 6, 155, 148, 90, 10

    LTEXT "选中序号", -1, 12, 170, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 7, 90, 168, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 7, 155, 170, 90, 10

    LTEXT "页码/次要", -1, 12, 192, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 8, 90, 190, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 8, 155, 192, 90, 10

    LTEXT "选中标记", -1, 12, 214, 70, 10
    PUSHBUTTON "选择...", IDC_CLR_BTN_BASE + 9, 90, 212, 55, 14
    LTEXT "", IDC_CLR_HEX_BASE + 9, 155, 214, 90, 10

    DEFPUSHBUTTON "确定", IDOK, 150, 256, 60, 14
    PUSHBUTTON "取消", IDCANCEL, 220, 256, 60, 14
END

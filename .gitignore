*.exe

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Node
node_modules/

# Sessions
sessions/

# 下载的开源词库原始文件（build_dict.py 自动重新下载）
resources/rime_ice/

# 词库预编译索引（0.2.29 部署生成，非源码）
system_dict.db.bin
domains.db.bin

# ── 词库构建职责：taishen-dict 项目（IME 只消费，不构建）──
# 三个 SQLite 词库均由 taishen-dict 管线产出，经 tools/sync_to_ime.py 同步；
# 本仓库不构建/管理词库。tools/archive/ 下为历史遗留构建脚本（仅供追溯）。
system_dict.db
domains.db
common.db
bigram.db

# 临时脚本/构建辅助（AI 会话临时文件）
tmp/
tools/tmp_*
*.dbN
*.dbE

# 构建日志
platform/windows/build_log*.txt
platform/windows/*.log
engine/*.log
docs/*.log
docs/*.log.err

# 打包产物（install.nsi 的编译输入，由 package.ps1 生成）
install/out/
# 安装包压缩分发版（package.ps1 产物）
install/*.zip

# 词库索引备份与运行时碎片（体积大，不入库）
resources/*.db.bin.v[0-9]*
resources/domains/*.db.bin.v[0-9]*
resources/*.dbd
resources/*.dbg
resources/*.dby
# SQLite 运行时索引（引擎查询自动生成）
resources/*.dbi
# SQLite WAL 运行时文件（进程关闭后自动清理，不入库）
resources/*.db-shm
resources/*.db-wal
resources/domains/*.db-shm
resources/domains/*.db-wal
# 引擎异步加载的分片缓存（shard，可重建）
resources/system_dict.db[A-Za-z]
resources/domains/*.db[A-Za-z]

# 工具缓存
.codegraph/
.playwright-cli/

# AI 运行时数据（子代理输出等，本机生成）
.taishen/
